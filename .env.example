SITE_ID=cowinmagnet_southern_africa
SITE_NAME=Cowinmagnet Southern Africa
COUNTRY_CODE=ZA
DEFAULT_LOCALE=en-ZA
SUPPORTED_LOCALES=en-ZA,af-ZA
DEFAULT_CURRENCY=USD
REFERENCE_CURRENCY=ZAR
TIMEZONE=Africa/Johannesburg

APP_URL=http://localhost:8090
NEXT_PUBLIC_SITE_URL=http://localhost:8090

# Required in production for durable CMS and enquiry storage. Do not deploy
# public forms with this unset: Vercel temporary storage is intentionally rejected.
DATABASE_URL=
DIRECT_DATABASE_URL=

CACHE_PREFIX=cowinmagnet_southern_africa
REDIS_URL=

STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# A sender address verified by the ZA project's Resend account.
INQUIRY_NOTIFICATION_FROM=
# Server-only: needs permission to send, and to read email delivery status.
RESEND_API_KEY=

NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:cowinmagnet.co.za
GOOGLE_SEARCH_CONSOLE_ENABLED=false
GOOGLE_SEARCH_CONSOLE_SITEMAP_URL=https://cowinmagnet.co.za/sitemap.xml
GOOGLE_SERVICE_ACCOUNT_JSON=
# Bound each Search Console URL Inspection run so it completes within the
# serverless execution limit. The job resumes at the next sitemap URL.
GSC_INSPECTION_BATCH_SIZE=12
SENTRY_DSN=

AUTH_SECRET=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Admin backend auth, same deployment pattern as the main Cowinmagnet site.
ADMIN_EMAIL=info@cowinmagnet.com
ADMIN_JWT_SECRET=
ADMIN_PASSWORD_HASH=
# Optional: email -> saltHex:scryptHashHex (16-byte salt, 64-byte digest).
ADMIN_TEAM_CREDENTIALS={}

# The ZA News autopublisher is paused. This does not affect the Blog webhook.
NEWS_AUTOPUBLISH_ENABLED=false
NEWS_AUTOPUBLISH_MODE=disabled
CRON_SECRET=

# Third-party Blog publisher. Keep this in the Vercel Production environment;
# never expose it to the browser or commit the production value.
WEBHOOK_ARTICLE_SIGN=
